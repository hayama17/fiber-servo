{
  "name": "fiber-servo",
  "version": "0.1.0",
  "description": "React Fiber as the control plane for a single-node container orchestrator: containers, ReplicaSets and Services, applied through nerdctl compose and observed through containerd.",
  "keywords": [
    "react",
    "react-reconciler",
    "containers",
    "containerd",
    "nerdctl",
    "compose",
    "orchestration",
    "reconciler",
    "declarative",
    "jsx"
  ],
  "license": "MIT",
  "author": "Kohei Hayama (https://github.com/hayama17)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayama17/fiber-servo.git"
  },
  "bugs": "https://github.com/hayama17/fiber-servo/issues",
  "homepage": "https://github.com/hayama17/fiber-servo#readme",
  "type": "module",
  "bin": {
    "fiber-servo": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-protos.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "example": "tsx src/cli.ts up examples/basic.tsx --runtime memory",
    "example:webapp": "tsx src/cli.ts up examples/webapp.tsx --runtime memory",
    "example:plan": "tsx src/cli.ts plan examples/app.tsx",
    "example:containerd": "tsx src/cli.ts up examples/app.tsx",
    "example:replicaset": "tsx src/cli.ts up examples/replicaset.tsx --runtime memory"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "esbuild": "^0.28.2",
    "protobufjs": "^8.8.0",
    "react-reconciler": "^0.34.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.33.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
